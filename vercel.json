{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "node scripts/validate-syntax.js",
  "installCommand": "npm install",
  "builds": [{ "src": "server.js", "use": "@vercel/node" }],
  "routes": [
    { "src": "/(.*)", "dest": "server.js" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|svg|webp|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/process-notifications", "schedule": "0 9 * * *" },
    { "path": "/api/cron/pending-registration-reminders", "schedule": "0 10 * * *" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
