{
  "version": 2,
  "buildCommand": "node scripts/prepare-static-deploy.js",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.vaidyagogate.org/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api.vaidyagogate.org/uploads/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.vaidyagogate.org"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "admin.vaidyagogate.org"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "judge.vaidyagogate.org"
        }
      ],
      "destination": "/judge.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "judge.vaidyagogate.org"
        }
      ],
      "destination": "/judge.html",
      "permanent": false
    },
    {
      "source": "/scanner",
      "destination": "/scanner.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/api-config.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*\\.(html|js))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
