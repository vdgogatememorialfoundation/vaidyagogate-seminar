# Production — Render + Neon + Wix subdomains (see deploy/DEPLOY-RENDER.md)
PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional: direct Neon URL for schema DDL (omit to auto-strip -pooler from DATABASE_URL)
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
PUBLIC_BASE_URL=https://seminar.vaidyagogate.org
# Optional override for shipment track links only (defaults to PUBLIC_BASE_URL)
# PUBLIC_TRACK_BASE_URL=https://seminar.vaidyagogate.org
# Optional: only if static frontend on another host calls a separate API
# API_BACKEND_URL=https://api.vaidyagogate.org
SEMINAR_HOST=seminar.vaidyagogate.org
ADMIN_HOST=admin.vaidyagogate.org
JUDGE_HOST=judge.vaidyagogate.org
WIX_SITE_URL=https://www.vaidyagogate.org

# Primary: Zoho ZeptoMail HTTPS API (default until quota reached)
EMAIL_API_PROVIDER=zeptomail
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=noreply@seminar.vaidyagogate.org
# Fallback when ZeptoMail limit hit (auto-switches per send)
EMAIL_API_FALLBACK_PROVIDER=sender
SENDER_NET_API_TOKEN=

# Zoho SMTP — standby when Sender.net fails (also set in Admin → Global Settings)
ZOHO_HOST=smtp.zoho.in
ZOHO_PORT=465
ZOHO_USER=info@vaidyagogate.org
ZOHO_PASS=your-app-password
ZOHO_FROM=info@vaidyagogate.org

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional extra verify strings (comma-separated) accepted for Meta webhook GET
WHATSAPP_VERIFY_TOKEN_ALT=
WHATSAPP_TEMPLATE_LANG=en
# Approved Meta template name for OTP (optional; see deploy/WHATSAPP-TEMPLATES.md)
WHATSAPP_OTP_TEMPLATE_NAME=

ADMIN_CONTACT_EMAIL=info@vaidyagogate.org
SUPPORT_CARE_EMAIL=care@vaidyagogate.org
OTP_RETURN_CODE=0
REQUIRE_SIGNUP_OTP=1

# Razorpay Standard Checkout (test: rzp_test_… / live: rzp_live_…)
# Set on Render → Environment. Synced into Admin payment_gateways on boot.
# KEY_SECRET must never be exposed to the browser.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
JWT_SECRET=change-me-long-random

# Cloudflare R2 — large case presentation uploads (100–250 MB per file)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional custom domain for R2 (signed URLs used by default)
# R2_PUBLIC_URL=

# Google Drive daily backup — personal Gmail (OAuth). Workspace service accounts need Shared drives.
# Google Cloud → APIs → Drive API → OAuth consent → Web client → redirect URI below.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# Optional override (default: PUBLIC_BASE_URL + /api/admin/platform-backup/google-oauth/callback)
# GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://seminar.vaidyagogate.org/api/admin/platform-backup/google-oauth/callback

# Inbound support ticket email (no Mailparser) — Gmail IMAP poller (free)
# 1) In Zoho Mail: forward care@vaidyagogate.org → vd.gogatememorialfoundation@gmail.com
# 2) Google Account → Security → 2-Step Verification → App passwords → create "Seminar inbound"
# 3) Set on Render:
GMAIL_INBOUND_ENABLED=1
GMAIL_INBOUND_USER=vd.gogatememorialfoundation@gmail.com
GMAIL_INBOUND_APP_PASSWORD=
GMAIL_INBOUND_POLL_MS=120000
# Optional webhook (SendGrid/Mailgun) — same ingest as Gmail poller
INBOUND_MAIL_WEBHOOK_SECRET=change-me-long-random
INBOUND_REPLY_DOMAIN=vaidyagogate.org
# Set INBOUND_PLUS_ADDRESSING=1 only if your domain receives ticket-reply+*@ addresses
INBOUND_PLUS_ADDRESSING=0
# Legacy Mailparser (optional — not required)
# MAILPARSER_INBOUND_EMAIL=
MAIL_PARSER_RELAX_DOMAIN=1
# Case marksheet auto eligibility threshold (% of max marks, default 60)
CASE_ELIGIBILITY_PCT=60

# PostgreSQL pool + registration burst protection (Render: set PG_POOL_MAX=20 on paid plan)
# PG_POOL_MAX=20
# REG_SUBMIT_RATE_MAX=8
# REG_DRAFT_RATE_MAX=30
# AUTH_LOGIN_RATE_MAX=20

# Render free tier — self-ping to reduce spin-down (uses PUBLIC_BASE_URL or RENDER_EXTERNAL_URL)
# DISABLE_RENDER_KEEPALIVE=1
# RENDER_KEEPALIVE_INTERVAL_MS=600000

# Local dev without Neon — omit DATABASE_URL to use database.sqlite
# SQLITE_PATH=./database.sqlite
